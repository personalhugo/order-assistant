# Copie para .env e preencha. Sem chave, a API roda em "modo offline" (heurística por palavras-chave).
ANTHROPIC_API_KEY=
MODELO_LLM=claude-opus-5-5
ESFORCO_LLM=low
MAX_SUGESTOES=3

# Banco de dados. Padrão: SQLite em data/pedidos.db (criado e populado na primeira execução).
# Para Postgres: pip install "psycopg[binary]" e use algo como
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/pedidos
# DATABASE_URL=sqlite:///./data/pedidos.db

# Frete grátis quando o subtotal de um restaurante atinge este valor
FRETE_GRATIS_ACIMA=80

# Usado pelo Streamlit
API_URL=http://localhost:8000
